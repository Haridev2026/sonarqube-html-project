pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            "\${scannerHome}/bin/sonar-scanner" \
                            -Dsonar.projectKey=sonarqube-html-project \
                            -Dsonar.projectName=sonarqube-html-project \
                            -Dsonar.sources=. \
                            -Dsonar.inclusions=**/*.html \
                            -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }
    }
}
